node_modules/
.pnpm-store/
.yarn/
.pnp.*
# Cargo 本地依赖副本
vendor/

# ── 构建产物 ──────────────────────────────────────────────────
dist/
dist-ssr/
.vite/
build/
out/
*.tsbuildinfo
tsconfig.tsbuildinfo

