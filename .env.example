# 内置共享凭据：只供正式构建使用（GitHub Actions secrets / 发布机环境变量）。
#
# 迁移 SQL 只留空占位；src-tauri/build.rs 通过 option_env! 注入，
# 启动时由 db::repositories::builtin_credentials::sync 写入 SQLCipher 库。
# 本地开发全部留空即可：内置额度通道降级为「未配置」，用户自填 BYOK 不受影响。
#
# 安全边界：这些值会被编译进客户端二进制，随安装包分发仍可被逆向提取。
# 本方案解决的是「源码仓库 / git 历史明文泄露」，不是「对终端用户保密」；
# 要真正保密须改为服务端代理转发，或改为纯 BYOK（用户自填 Key）。
#
# 本文件只列变量名，**绝不填写真实值**；.gitignore 已忽略 .env / .env.*。
# 用法：复制为 .env 后按需填写，或在 CI 的 Repository secrets 中配置同名变量。

# M6：内置免费额度 LLM
QIQI_ZHIPU_API_KEY=
QIQI_SILICONFLOW_API_KEY=

# M12 / M13：内置翻译 · 百度（APPID 与密钥成对）
QIQI_BAIDU_APPID=
QIQI_BAIDU_SECRET=

# M13：内置翻译 · 讯飞（三项）
QIQI_XFYUN_APPID=
QIQI_XFYUN_API_SECRET=
QIQI_XFYUN_API_KEY=
