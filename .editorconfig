# EditorConfig: baseline editor settings for both frontend (TS/Vue) and Rust.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{bat,ps1,cmd}]
end_of_line = crlf
