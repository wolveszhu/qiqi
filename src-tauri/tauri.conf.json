{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qiqi",
  "version": "0.1.0",
  "identifier": "com.brave.qiqi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qiqi",
        "width": 150,
        "height": 150,
        "minWidth": 150,
        "minHeight": 150,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "Qiqi · Settings",
        "width": 1000,
        "height": 660,
        "minWidth": 900,
        "minHeight": 620,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
